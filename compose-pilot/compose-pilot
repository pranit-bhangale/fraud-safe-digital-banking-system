#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="${SCRIPT_DIR}/src:${SCRIPT_DIR}/.venv/lib/python*/site-packages:${SCRIPT_DIR}/.venv/Lib/site-packages:${PYTHONPATH:-}"
export PYTHONIOENCODING="utf-8"

PYTHON_BIN="python3"
if ! command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="python"
fi

exec "$PYTHON_BIN" -m compose_pilot "$@"
